{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 10,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 220
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "article",
        "research-note",
        "experiment",
        "architecture",
        "field-note"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "detection-engineering",
        "threat-intelligence",
        "security-automation",
        "telemetry",
        "platform-reliability",
        "deception-engineering",
        "ai-security",
        "research"
      ]
    },
    "tags": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "introductory",
        "intermediate",
        "advanced"
      ]
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mitre": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "repository": {
      "type": "string",
      "format": "uri"
    },
    "canonicalUrl": {
      "type": "string",
      "format": "uri"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "publishedAt",
    "status",
    "type",
    "category",
    "tags"
  ]
}