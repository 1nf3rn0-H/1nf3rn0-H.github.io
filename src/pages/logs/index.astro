---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const logs = (await getCollection('logs', ({ data }) => data.status === 'published')).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const types = ['all', 'article', 'research-note', 'experiment', 'architecture', 'field-note'];
const base = import.meta.env.BASE_URL;
---
<BaseLayout path="/logs/" title="Research Logs — Telemetry Lab" description="Articles, experiments, architectures, implementation notes, and observations from security engineering work."><header class="logs-hero"><p class="eyebrow">Indexed collection</p><h1>Research Logs</h1><p class="lede">Articles, experiments, architectures, implementation notes, and observations from security engineering work.</p></header><div class="filters" aria-label="Filter research logs">{types.map((type,index) => <button class="filter" type="button" data-filter={type} aria-pressed={index === 0 ? 'true' : 'false'}>{type.replace('-', ' ').toUpperCase()}</button>)}</div><div class="log-list" id="log-list">{logs.map((log,index) => <a class="log-row" href={`${base}logs/${log.id}/`} data-type={log.data.type}><time class="log-date" datetime={log.data.publishedAt.toISOString()}>{log.data.publishedAt.toLocaleDateString('en-GB',{year:'numeric',month:'short',day:'2-digit'}).toUpperCase()}</time><div><p class="log-id">LOG-{String(index+1).padStart(4,'0')} · {log.data.status.toUpperCase()}</p><h2>{log.data.title}</h2><p>{log.data.description}</p><div class="log-meta"><span>{log.data.type.toUpperCase()}</span><span>·</span><span>{log.data.category.toUpperCase()}</span>{log.data.tags.map((tag) => <span class="tag">#{tag}</span>)}</div></div><span class="log-arrow" aria-hidden="true">↗</span></a>)}</div><p class="empty-state" hidden>No logs matched the selected telemetry filters.</p><script>const filters = document.querySelectorAll<HTMLButtonElement>('.filter'); const rows = document.querySelectorAll<HTMLElement>('.log-row'); const empty = document.querySelector<HTMLElement>('.empty-state'); filters.forEach((filter) => filter.addEventListener('click', () => { const value = filter.dataset.filter; filters.forEach((button) => button.setAttribute('aria-pressed',String(button===filter))); let visible=0; rows.forEach((row) => { const matches=value==='all'||row.dataset.type===value; row.hidden=!matches;if(matches)visible++; });if(empty)empty.hidden=visible>0; }));</script></BaseLayout>
