---
import '../styles/global.css';
import { siteConfig } from '../config/site';
interface Props { title?: string; description?: string; path?: string }
const { title = siteConfig.title, description = siteConfig.description, path = '/' } = Astro.props;
const base = import.meta.env.BASE_URL;
const siteUrl = String(Astro.site ?? siteConfig.url);
const canonical = new URL(path.replace(/^\//, ''), `${siteUrl}${siteUrl.endsWith('/') ? '' : '/'}`);
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`}/><link rel="canonical" href={canonical}/><link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} research logs`} href={`${base}rss.xml`}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta name="twitter:card" content="summary"/><title>{title}</title></head><body><div class="shell"><a class="skip-link" href="#content">Skip to content</a><header class="site-header"><a class="brand" href={base}><span class="brand-name">Telemetry Lab</span><span class="brand-owner">HARSH MEHTA</span></a><nav class="site-nav" aria-label="Primary navigation"><a href={`${base}about/`} aria-current={path === '/about/' ? 'page' : undefined}>ABOUT</a><a href={base} aria-current={path === '/' || path.startsWith('/logs') ? 'page' : undefined}>LOGS</a><span class="nav-social"><a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer">GITHUB ↗</a><a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer">LINKEDIN ↗</a><a href={siteConfig.social.medium} target="_blank" rel="noopener noreferrer">MEDIUM ↗</a><a href={`${base}rss.xml`}>RSS</a></span></nav></header><main id="content"><slot /></main><footer class="footer"><span>TELEMETRY LAB</span><span>STATIC SYSTEM · GITHUB PAGES</span><span>© 2026 HARSH MEHTA</span></footer></div></body></html>
