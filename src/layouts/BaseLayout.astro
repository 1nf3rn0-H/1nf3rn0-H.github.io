---
import '../styles/global.css';
import { siteConfig } from '../config/site';
interface Props { title?: string; description?: string; path?: string; image?: string; mode?: 'default' | 'publication' }
const { title = siteConfig.title, description = siteConfig.description, path = '/', image, mode = 'default' } = Astro.props;
const base = import.meta.env.BASE_URL;
const siteUrl = String(Astro.site ?? siteConfig.url);
const canonical = new URL(path.replace(/^\//, ''), `${siteUrl}${siteUrl.endsWith('/') ? '' : '/'}`);
const socialImage = image ? new URL(image.replace(/^\//, ''), `${siteUrl}${siteUrl.endsWith('/') ? '' : '/'}`) : undefined;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`}/><link rel="canonical" href={canonical}/><link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} research logs`} href={`${base}rss.xml`}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/>{socialImage&&<meta property="og:image" content={socialImage}/>}<meta name="twitter:card" content={socialImage?'summary_large_image':'summary'}/>{socialImage&&<meta name="twitter:image" content={socialImage}/>}<title>{title}</title></head><body class:list={{'publication-page':mode==='publication'}}><div class="issue-bar"><div class="shell"><span>SECURITY ENGINEERING · SYSTEMS RESEARCH</span><span>NOTES FROM THE INSTRUMENTATION LAYER</span></div></div><div class:list={['shell',{'publication-shell':mode==='publication'}]}><a class="skip-link" href="#content">Skip to content</a><header class="site-header"><a class="brand" href={base}><span class="brand-name">Telemetry Lab</span><span class="brand-owner">HARSH MEHTA · RESEARCH JOURNAL</span></a><nav class="site-nav" aria-label="Primary navigation"><a href={`${base}logs/`} aria-current={path.startsWith('/logs') ? 'page' : undefined}>LOGS</a><a href={`${base}field-notes/`} aria-current={path.startsWith('/field-notes')&&!path.startsWith('/field-notes/archive') ? 'page' : undefined}>FIELD NOTES</a><a href={`${base}field-notes/archive/`} aria-current={path.startsWith('/field-notes/archive') ? 'page' : undefined}>ARCHIVE</a><a href={`${base}about/`} aria-current={path === '/about/' ? 'page' : undefined}>ABOUT</a><span class="nav-social"><a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer">GITHUB ↗</a><a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer">LINKEDIN ↗</a><a href={`${base}rss.xml`}>RSS</a></span></nav></header><main id="content"><slot /></main><footer class="footer"><span>TELEMETRY LAB · FIELD NOTES</span><span>STATIC SYSTEM · GITHUB PAGES</span><span>© 2026 HARSH MEHTA</span></footer></div></body></html>
